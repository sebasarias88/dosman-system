# Copy this file to .env.local and fill it with the values from
# Supabase → Project Settings → API Keys. Both values are public by design.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Only used by `yarn db:types`.
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
