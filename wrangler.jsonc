{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dosman-system",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    // The React app is a single-page application: unknown paths load index.html.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; every other request is a free static asset.
    "run_worker_first": ["/api/*"],
  },
  "r2_buckets": [
    {
      // Product photos and expense receipts. Read and written only through the Worker.
      "binding": "MEDIA",
      "bucket_name": "dosman-media",
    },
  ],
  // Workers AI for the help assistant ("Ayuda"). Free: 10,000 neurons per day.
  "ai": { "binding": "AI" },
  "triggers": {
    // Free plan: delivers queued notifications every 5 minutes, and at 5:30 a.m.
    // Colombia time (10:30 UTC, after the business day closes) enters the fixed
    // expenses and sends yesterday's summary.
    "crons": ["*/5 * * * *", "30 10 * * *"],
  },
  "vars": {
    // Public values (safe in the browser too). Secrets go through `wrangler secret put`:
    //   SUPABASE_SECRET_KEY  (staff accounts and notifications)
    //   TELEGRAM_BOT_TOKEN   (bot created with @BotFather)
    "SUPABASE_URL": "https://vrstvaekufrofwjnkfrf.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_6aErS-P_v0A7GoHaBnbHJw_d4Pe9jmu",
  },
}
